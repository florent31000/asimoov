{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asimoov.dev/schemas/app.v1.json",
  "title": "App v1",
  "description": "Static app manifest. See contracts/app_manifest.py: AppManifest.",
  "type": "object",
  "required": ["apiVersion", "kind", "name", "version", "description", "entrypoint"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "asimoov/v1" },
    "kind": { "const": "App" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "camera.frames",
          "llm.vision",
          "memory.read",
          "memory.write",
          "persons.read",
          "persons.write",
          "mail.send",
          "network.outbound",
          "body.motion",
          "body.gesture",
          "audio.in",
          "audio.out"
        ]
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "behaviors": { "type": "array", "items": { "type": "string" } },
        "percepts": { "type": "array", "items": { "type": "string" } },
        "persona_fragment": { "type": "string" },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["on", "match"],
            "additionalProperties": false,
            "properties": {
              "on": { "type": "string" },
              "match": { "type": "string" },
              "hint_tool": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "python": { "type": "string" }
      }
    },
    "degraded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["when_missing"],
        "additionalProperties": false,
        "properties": {
          "when_missing": { "type": "string" },
          "disable": { "type": "array", "items": { "type": "string" } },
          "persona_fragment": { "type": "string" }
        }
      }
    }
  }
}
